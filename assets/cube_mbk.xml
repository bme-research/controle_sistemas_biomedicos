<mujoco model="simple_cube">

    <include file="scene.xml"/>

    <option solver="CG" tolerance="1e-6"/>

    <size nconmax="50" njmax="500" nstack="50000"/>

    <worldbody>
      <body name="link1" pos="0 0 0.5">
          <geom type="box" size="0.05 0.05 0.05" rgba="0.15 0.5 0.15 1"/>
          <joint name="q1" type="slide" pos="0 0 0.2" axis="1 0 0" frictionloss="0.0" damping="0.0"/>
          <site name="site_link1" pos="-0.05 0 0"/>
      </body>

      <body name="target_massless" pos="-0.2 0 0.5">
          <joint name="q_target" type="slide" axis="1 0 0" frictionloss="0.0" damping="0.0"/>
          <geom type="sphere" size="0.02" rgba="0.8 0.2 0.2 0.7"/>
          <site name="site_target" pos="0 0 0"/>
      </body>
    </worldbody>

    <tendon>
        <spatial name="tendon_spring_damper" stiffness="10" damping="1">
            <site site="site_link1"/>
            <site site="site_target"/>
        </spatial>
    </tendon>

    <actuator>
        <position name="target_position" joint="q_target" kp="100"/>
        <motor name="motor_1" joint="q1" gear="1"/>
    </actuator>
</mujoco>