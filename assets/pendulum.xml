<mujoco model="simple_cube">

    <include file="scene.xml"/>

    <option solver="CG" tolerance="1e-6"/>

    <size nconmax="50" njmax="500" nstack="50000"/>

    <worldbody>
      <body name="link1" pos="0 0 1">
          <geom type="box" size="0.05 0.005 0.75" rgba="0.15 0.5 0.15 1"/>
          <joint name="q1" type="hinge" pos="0 0 0.75" axis="0 1 0" frictionloss="0.0" damping="0"/>
      </body>
    </worldbody>

    <actuator>
        <motor name="motor_1" joint="q1" gear="1"/>
    </actuator>
</mujoco>