<mujoco model="simple_cube">

    <include file="scene.xml"/>

    <option solver="CG" tolerance="1e-6"/>

    <size nconmax="50" njmax="500" nstack="50000"/>

    <worldbody>
      <body name="cube" pos="0 0 0.25">
          <geom type="box" size="0.05 0.05 0.05" rgba="0.15 0.5 0.15 1"/>
          <joint name="q" type="free" pos="0 0 0" axis="1 0 0" frictionloss="0" damping="0.0"/>
      </body>
    </worldbody>

    <!-- <actuator>
        <motor name="motor_1" joint="q" gear="1"/>
    </actuator> -->
</mujoco>